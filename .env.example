VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI provider (optional for MVP 1) --------------------------------------
# MVP 1 ships with a mock AI provider (src/lib/ai/providers/mockProvider.js)
# that needs no key at all, so the app works end to end with zero setup.
# To switch to a real provider later, set VITE_AI_PROVIDER and implement a
# provider module under src/lib/ai/providers/ — see src/lib/ai/index.js.
# Never call a real AI provider directly from the browser with a secret key;
# route that call through a server-only function (see api/) the same way
# this codebase would keep any other secret out of the client bundle.
# VITE_AI_PROVIDER=mock
